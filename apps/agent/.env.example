GOODNIGHT_DEVICE_TRANSPORT=memory
GOODNIGHT_MQTT_HOST=127.0.0.1
GOODNIGHT_MQTT_PORT=1883
GOODNIGHT_MQTT_BASE_TOPIC=goodnight
GOODNIGHT_MQTT_DEVICE_ID=mock-arm
GOODNIGHT_MQTT_USERNAME=
GOODNIGHT_MQTT_PASSWORD=
GOODNIGHT_SENSOR_AUTOMATION_ENABLED=false
GOODNIGHT_VITALS_REQUIRED_SAMPLES=3
GOODNIGHT_SENSOR_FRESHNESS_SECONDS=5
GOODNIGHT_AUTOMATION_COOLDOWN_SECONDS=10

# ENV-SENSING-S3 联调时改为 env_s3_mqtt，并使用负责人单独提供的认证信息：
# GOODNIGHT_DEVICE_TRANSPORT=env_s3_mqtt
# GOODNIGHT_MQTT_HOST=218.11.5.249
# GOODNIGHT_MQTT_PORT=10317
# GOODNIGHT_MQTT_DEVICE_ID=env-s3-01
